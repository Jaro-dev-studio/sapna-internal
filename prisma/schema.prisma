datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id String @id @default(cuid())

  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(VIEWER)

  roleId String?
  customRole Role? @relation(fields: [roleId], references: [id])

  permissionOverride UserPermissionOverride?

  projects               ProjectMember[]
  calculations           Calculation[]
  assignedTasks          Task[]           @relation("TaskAssignee")
  createdTasks           Task[]           @relation("TaskCreatedBy")
  taskViews              TaskView[]       @relation("TaskViews")
  aiChats                AIChat[]
  assignedRecurringTasks RecurringTask[]  @relation("RecurringTaskAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  permissions Json

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPermissionOverride {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  members                  ProjectMember[]
  tasks                    Task[]
  recurringTasks           RecurringTask[]
  slackNotificationConfigs SlackNotificationConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model ProjectMember {
  id String @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ============================================
// TASKS
// ============================================

model Task {
  id          String       @id @default(cuid())
  name        String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  attachments Attachment[]

  blockedByTasks Task[] @relation("TaskBlockedByTask")
  blockingTasks  Task[] @relation("TaskBlockedByTask")

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdById])
}

model Attachment {
  id   String @id @default(cuid())
  name String
  url  String
  type String
  size Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING_ADMIN_REVIEW
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

// ============================================
// VIEWS (saved filters for tasks)
// ============================================

model TaskView {
  id   String @id @default(cuid())
  name String

  viewMode      String  @default("table")
  sortColumn    String?
  sortDirection String  @default("asc")

  statusFilters    String[]
  priorityFilters  String[]
  projectFilters   String[]
  assigneeFilters  String[]
  createdByFilters String[]

  userId String
  user   User   @relation("TaskViews", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


// ============================================
// RECURRING TASKS
// ============================================

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model RecurringTask {
  id          String       @id @default(cuid())
  name        String
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)

  frequency  RecurrenceFrequency
  dayOfWeek  Int?
  dayOfMonth Int?
  isActive   Boolean             @default(true)

  lastCreatedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assigneeId String?
  assignee   User?   @relation("RecurringTaskAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isActive])
}

// ============================================
// SLACK NOTIFICATIONS
// ============================================

model SlackNotificationConfig {
  id String @id @default(cuid())

  eventType      SlackNotificationEventType
  sendToPublic   Boolean @default(false)
  sendToInternal Boolean @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, eventType])
  @@index([projectId])
}

enum SlackNotificationEventType {
  TASK_COMPLETED
  TASK_UNBLOCKED
}

// ============================================
// CALCULATIONS
// ============================================

model Calculation {
  id          String   @id @default(cuid())
  name        String
  description String?
  flowData    Json?
  createdBy   User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// AI CHAT
// ============================================

model AIChat {
  id    String @id @default(cuid())
  title String @default("New Chat")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages AIChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model AIChatMessage {
  id      String @id @default(cuid())
  role    String
  content String @db.Text

  toolCalls Json?

  chatId String
  chat   AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([chatId])
}

// ============================================
// FORM SUBMISSIONS (generic)
// ============================================

model FormSubmission {
  id String @id @default(cuid())

  name    String
  email   String
  message String?  @db.Text
  fields  Json?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ============================================
// E-COMMERCE SITES
// ============================================

model Site {
  id          String     @id @default(cuid())
  name        String
  domain      String     @unique
  platform    String     @default("shopify")
  status      SiteStatus @default(ACTIVE)
  description String?
  logoUrl     String?

  shopifyStoreId   String?
  shopifyApiKey    String?
  shopifyApiSecret String?

  campaigns       Campaign[]
  creatives       Creative[]
  seoAnalyses     SEOAnalysis[]
  productListings ProductListing[]
  analyticsData   AnalyticsSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum SiteStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
}

// ============================================
// AD CAMPAIGNS
// ============================================

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  platform    AdPlatform
  status      CampaignStatus @default(DRAFT)
  objective   String?

  budget      Float @default(0)
  dailyBudget Float @default(0)
  spent       Float @default(0)

  startDate DateTime?
  endDate   DateTime?

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  creatives Creative[]
  metrics   CampaignMetrics?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([status])
  @@index([platform])
}

enum AdPlatform {
  META
  GOOGLE
  TIKTOK
  PINTEREST
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model CampaignMetrics {
  id         String @id @default(cuid())
  campaignId String @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  impressions Int   @default(0)
  clicks      Int   @default(0)
  conversions Int   @default(0)
  spend       Float @default(0)
  revenue     Float @default(0)

  ctr  Float @default(0)
  cpc  Float @default(0)
  cpm  Float @default(0)
  roas Float @default(0)

  updatedAt DateTime @updatedAt
}

// ============================================
// AD CREATIVES
// ============================================

model Creative {
  id          String        @id @default(cuid())
  name        String
  type        CreativeType
  status      CreativeStatus @default(DRAFT)
  
  headline    String?
  description String?        @db.Text
  callToAction String?
  
  imageUrl    String?
  videoUrl    String?
  thumbnailUrl String?

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  metrics CreativeMetrics?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([campaignId])
  @@index([type])
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  UGC
}

enum CreativeStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model CreativeMetrics {
  id         String @id @default(cuid())
  creativeId String @unique
  creative   Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  impressions Int   @default(0)
  clicks      Int   @default(0)
  conversions Int   @default(0)
  spend       Float @default(0)

  ctr  Float @default(0)
  cvr  Float @default(0)

  updatedAt DateTime @updatedAt
}

// ============================================
// SEO ANALYSIS
// ============================================

model SEOAnalysis {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  overallScore    Int @default(0)
  technicalScore  Int @default(0)
  onPageScore     Int @default(0)
  contentScore    Int @default(0)
  backlinksScore  Int @default(0)

  totalKeywords      Int @default(0)
  keywordsTop10      Int @default(0)
  keywordsTop100     Int @default(0)
  organicTraffic     Int @default(0)
  backlinksCount     Int @default(0)
  domainAuthority    Int @default(0)

  issues          Json?
  recommendations Json?

  analyzedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  keywords SEOKeyword[]

  @@index([siteId])
  @@index([analyzedAt])
}

model SEOKeyword {
  id            String @id @default(cuid())
  seoAnalysisId String
  seoAnalysis   SEOAnalysis @relation(fields: [seoAnalysisId], references: [id], onDelete: Cascade)

  keyword       String
  position      Int?
  previousPosition Int?
  searchVolume  Int      @default(0)
  difficulty    Int      @default(0)
  url           String?
  
  trackedAt DateTime @default(now())

  @@index([seoAnalysisId])
  @@index([keyword])
}

// ============================================
// PRODUCT LISTINGS
// ============================================

model ProductListing {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  externalId  String?
  title       String
  description String?  @db.Text
  price       Float    @default(0)
  compareAtPrice Float?
  
  imageUrl    String?
  images      Json?
  
  category    String?
  tags        String[]
  
  inventory   Int      @default(0)
  sku         String?
  
  status      ProductStatus @default(ACTIVE)
  
  seoTitle       String?
  seoDescription String?  @db.Text
  
  optimizationScore Int @default(0)
  optimizationSuggestions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([status])
  @@index([category])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  OUT_OF_STOCK
}

// ============================================
// ANALYTICS SNAPSHOTS
// ============================================

model AnalyticsSnapshot {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  date DateTime

  revenue      Float @default(0)
  orders       Int   @default(0)
  averageOrderValue Float @default(0)
  
  visitors     Int   @default(0)
  pageViews    Int   @default(0)
  bounceRate   Float @default(0)
  
  conversionRate Float @default(0)
  cartAbandonment Float @default(0)

  topProducts   Json?
  topSources    Json?
  topPages      Json?

  createdAt DateTime @default(now())

  @@unique([siteId, date])
  @@index([siteId])
  @@index([date])
}
